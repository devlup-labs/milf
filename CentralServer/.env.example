# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:@db...
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_server_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# Auth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=your-secure-secret-key-here

# WASI SDK Configuration
# Point this to the 'clang' binary inside your extracted wasi-sdk
# Example: CLANG_PATH=/opt/wasi-sdk/bin/clang
CLANG_PATH=/opt/wasi-sdk/bin/clang
